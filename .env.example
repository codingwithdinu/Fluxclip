# Optional. Used only by the server-side YouTube metadata lookup.
# Create a key in Google Cloud Console and enable YouTube Data API v3.
YOUTUBE_API_KEY=

# Optional but recommended for shared production cache and per-IP rate limiting.
# Get both values from your Upstash Redis database's REST API section.
# Never prefix these with NEXT_PUBLIC_ or commit real credentials.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
